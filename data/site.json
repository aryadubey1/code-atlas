  "bugsPage": {
    "eyebrow": "Found while planning NB-421",
    "title": "Bugs I found",
    "lead": "Three bugs in today's bulk CSV import, all reproduced locally with the real code."
  },
  "bugsNote": "Reported to the Catalog channel on 18 Oct.",
  "bugs": [
    {
      "n": 1,
      "title": "Prices with a comma are rejected",
      "release": true,
      "review": true,
      "pr": "#1980",
      "when": "Aug 2026",
      "what": "A price written as 12,50 fails the whole import instead of being read as 12.50.",
      "example": "isbn,title,price\n9780000000011,The Quiet Harbour,\"12,50\"",
      "result": "Import stops at that row; nothing after it is saved.",
      "tested": "Uploaded a 3-row CSV on a local copy of production data."
    },
    {
      "n": 2,
      "title": "Blank author creates an empty author record",
      "release": true,
      "review": true,
      "pr": "#1712",
      "when": "May 2026",
      "what": "A row with no author creates an author with an empty name and links the book to it.",
      "example": "isbn,title,author\n9780000000028,Paper Lanterns,",
      "result": "An unnamed author shows up on the storefront.",
      "tested": "Imported the row, then opened the book page."
    },
    {
      "n": 3,
      "title": "Duplicate ISBNs in one file overwrite each other",
      "release": false,
      "review": true,
      "pr": "#2104",
      "when": "Sep 2026",
      "what": "Two rows with the same ISBN in one file: the second silently replaces the first.",
      "example": "isbn,title,price\n9780000000035,North Sea Tales,9.50\n9780000000035,North Sea Tales,10.50",
      "result": "Only 10.50 is kept, with no warning.",
      "tested": "Ran the importer spec with a duplicate row added."
    }
  ],
  "concepts": [
    {
      "term": "Background job",
      "line": "Slow work (reading a PDF) runs outside the web request, so the page answers straight away.",
      "pic": "web ──► queue ──► worker\n  └─ 200 OK      (reads file)",
      "tickets": [
        "NB-421"
      ]
    },
    {
      "term": "Feature flag",
      "line": "A switch that turns new code on per store, so it can ship dark and roll out slowly.",
      "pic": "if flag(:gift_langs, store)\n  new path\nelse\n  old path",
      "tickets": [
        "NB-412"
      ]
    },
    {
      "term": "Draft table",
      "line": "Rows the reader found are saved as drafts first; nothing touches the catalog until approved.",
      "pic": "file ─► drafts ─► review ─► catalog",
      "tickets": [
        "NB-421"
      ]
    },
    {
      "term": "i18n",
      "line": "Each piece of text lives in a translation file per language instead of in the code.",
      "pic": "t('gift.hello')\n en: Hello  de: Hallo",
      "tickets": [
        "NB-412"
      ]
    },
    {
      "term": "Presigned URL",
      "line": "A short-lived link that lets the browser upload straight to file storage.",
      "pic": "browser ──PUT──► bucket\n   ▲ link valid 10 min",
      "tickets": [
        "NB-421"
      ]
    },
    {
      "term": "N+1 query",
      "line": "Loading a list, then one extra query per row; fixed by loading the related rows together.",
      "pic": "1 query (books)\n+ N queries (authors) ✗\n→ includes(:author) ✓",
      "tickets": []
    },
    {
      "term": "Idempotency",
      "line": "Running the same thing twice gives the same result, so retries are safe.",
      "pic": "import(file) ×2 ─► 40 books, not 80",
      "tickets": [
        "NB-421"
      ]
    },
    {
      "term": "Scoped query",
      "line": "Every lookup starts from what the user is allowed to see.",
      "pic": "current_user.warehouses\n  .find(id)  ✓\nWarehouse.find(id) ✗",
      "tickets": [
        "NB-430"
      ]
    },
    {
      "term": "Migration",
      "line": "A versioned change to the database shape, run once on every environment.",
      "pic": "v41 ─► add_column ─► v42",
      "tickets": [
        "NB-421"
      ]
    },
    {
      "term": "OCR",
      "line": "Reading text out of an image or a scanned PDF.",
      "pic": "[photo] ─► \"Quiet Harbour 14.99\"",
      "tickets": [
        "NB-421"
      ]
    }
  ],
